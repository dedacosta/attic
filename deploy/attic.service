[Unit]
Description=Attic home inventory
After=network-online.target

[Service]
# @ATTIC_HOME@ is filled in by release.sh, which copies this file to ~/.config/systemd/user
# ATTIC_DATA, ATTIC_PORT and the backup settings, written by release.sh
EnvironmentFile=@ATTIC_HOME@/service/attic.env
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -jar @ATTIC_HOME@/service/attic.jar \
    --spring.profiles.active=prod --server.port=${ATTIC_PORT} --attic.database.file=${ATTIC_DATA}/attic.db
# Java exits with 143 when stopped with SIGTERM
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
